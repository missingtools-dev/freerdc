# Build environment for the distributable bundle: Ubuntu 22.04 (glibc 2.35), the oldest
# distro the app should run on. A PyInstaller bundle needs at least the glibc of the machine
# it was built on, so building here gives a bundle that also runs on everything newer
# (Debian 12 and 13, Ubuntu 24.04, Linux Mint 22, Fedora, ...).
FROM ubuntu:22.04
ENV DEBIAN_FRONTEND=noninteractive
# python + the system libraries PyInstaller copies into the bundle (the Qt xcb platform
# plugin and friends), so they come from 22.04 and not from a newer host.
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 python3-venv python3-pip libpython3.10 binutils \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-xinerama0 libxcb-xkb1 libxkbcommon0 \
        libxkbcommon-x11-0 libegl1 libgl1 libfontconfig1 libdbus-1-3 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
